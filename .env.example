# ---------------------------------------------------------------
# Kazi Halali — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# --- Model endpoint (OpenAI-compatible) ------------------------
# Production / submission: Nebius Token Factory (required by hackathon rules).
#   Confirm the base URL and exact model IDs at https://tokenfactory.nebius.com
# Development while credits are pending: NVIDIA API catalog (build.nvidia.com)
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=

# Model routing — each step uses the cheapest model that does the job well.
#   vision : reads screenshots / offer letters / certificate photos
#   extract: turns raw text into structured JSON facts (high volume, cheap)
#   reason : writes the final explanation in English + Swahili
# TODO: confirm exact IDs in the Token Factory model catalog.
MODEL_VISION=nvidia/Nemotron-Nano-V2-12b
MODEL_EXTRACT=nvidia/nemotron-3-nano-30b-a3b
MODEL_REASON=nvidia/nemotron-3-super-120b-a12b

# Set to "stub" to run the whole pipeline offline with canned model output
# (useful for UI work and tests). Leave empty for real calls.
LLM_MODE=

# --- Web search -------------------------------------------------
TAVILY_API_KEY=

# --- Storage ----------------------------------------------------
# "postgres" (default) or "memory" (no persistence; good for quick dev)
STORE=postgres
DATABASE_URL=postgres://kazi:kazi@localhost:5432/kazi?sslmode=disable

# --- Registry data ----------------------------------------------
# CSV snapshots loaded at startup when STORE=memory, and by `make ingest`.
AGENCIES_CSV=../data/sample/agencies.csv
FLAGGED_CSV=../data/sample/flagged.csv

# --- HTTP -------------------------------------------------------
PORT=8080
CORS_ORIGIN=http://localhost:3000

# --- Web (Next.js) ----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
